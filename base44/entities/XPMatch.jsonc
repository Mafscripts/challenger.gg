{
  "name": "XPMatch",
  "type": "object",
  "properties": {
    "host_id": { "type": "string", "title": "Host User ID" },
    "host_name": { "type": "string", "title": "Host Name" },
    "challenger_id": { "type": "string", "title": "Challenger User ID" },
    "challenger_name": { "type": "string", "title": "Challenger Name" },
    "team_alpha_player_ids": { "type": "array", "items": { "type": "string" } },
    "team_alpha_player_names": { "type": "array", "items": { "type": "string" } },
    "team_bravo_player_ids": { "type": "array", "items": { "type": "string" } },
    "team_bravo_player_names": { "type": "array", "items": { "type": "string" } },
    "joined_players": { "type": "number" },
    "total_players": { "type": "number" },
    "game_mode": { "type": "string", "enum": ["snd","overload","hp"] },
    "game_mode_display": { "type": "string" },
    "team_size": { "type": "string", "enum": ["1v1","2v2","3v3","4v4"] },
    "play_rule": { "type": "string", "enum": ["controller_only","mixed_pc_allowed","console_only"], "default": "controller_only" },
    "best_of": { "type": "number", "default": 1 },
    "maps": { "type": "array", "items": { "type": "string" } },
    "final_map_id": { "type": "string" },
    "final_map_name": { "type": "string" },
    "status": { "type": "string", "enum": ["open","accepted","ready","in_progress","awaiting_host_report","awaiting_challenger_report","score_conflict","disputed","completed","cancelled"], "default": "open" },
    "reported_score_alpha": { "type": "number" },
    "reported_score_bravo": { "type": "number" },
    "reported_score_by": { "type": "string" },
    "confirmed_score_alpha": { "type": "number" },
    "confirmed_score_bravo": { "type": "number" },
    "winner_id": { "type": "string" },
    "winner_name": { "type": "string" },
    "winner_score": { "type": "number" },
    "loser_score": { "type": "number" },
    "xp_changes": { "type": "object" },
    "proof_urls": { "type": "array", "items": { "type": "string" } },
    "posted_to_matchfinder": { "type": "boolean", "default": true },
    "match_start_deadline": { "type": "string", "format": "date-time" },
    "match_started_date": { "type": "string", "format": "date-time" },
    "match_completed_date": { "type": "string", "format": "date-time" },
    "cancelled_date": { "type": "string", "format": "date-time" },
    "created_date": { "type": "string", "format": "date-time" }
  },
  "required": ["host_id","host_name","game_mode","team_size"]
}