DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peak_rival_arena?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=4000
# Trust local nginx; Cloudflare hops are recognized separately by their published ranges.
TRUST_PROXY=loopback
# VPN/proxy/Tor protection for registration, login and authenticated API access.
# Obtain a server API key at https://proxycheck.io/ before enabling.
# Keep false until configured. Missing key/provider errors block protected access when enabled.
VPN_BLOCK_ENABLED=false
PROXYCHECK_API_KEY=""
# Optional exact public visitor IP exceptions, comma-separated; never bypasses account bans.
VPN_ALLOWED_IPS=""
VITE_API_URL="/api"
VITE_API_PROXY_TARGET="http://localhost:4000"

# Optional production TURN/STUN configuration for ranked voice. Keep unset for local testing.
# Example: [{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]
VITE_VOICE_ICE_SERVERS=""

# Keep false during public testing. Enabling requires both server and client flags.
PUBLIC_COMMERCE_ENABLED=false
VITE_PUBLIC_COMMERCE_ENABLED=false

# Required in production: unverified accounts cannot sign in without email delivery.
# Local development without SMTP displays a development-only verification code.
# Sender address for verification and password-reset emails.
EMAIL_FROM="TopFragg <support@topfragg.gg>"
EMAIL_VERIFICATION_SECRET="replace-with-a-second-long-random-secret"
# Preferred in production: HTTPS email delivery through Resend.
RESEND_API_KEY=""
SMTP_HOST="smtp.ionos.com"
SMTP_PORT=465
SMTP_USER="support@topfragg.gg"
SMTP_PASS=""
SMTP_SECURE=true
APP_URL="https://www.topfragg.gg"

# Cloudflare Turnstile for account registration. Leave BOTH keys empty until setup.
# Setting either key requires both; a partial configuration blocks registration.
# The public site key is served by the API. The secret key stays on the server.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
TURNSTILE_ALLOWED_HOSTNAMES="topfragg.gg,www.topfragg.gg"

# Topfragg Discord bot. Keep DISCORD_TOKEN secret and only store it in .env.
DISCORD_TOKEN=""
DISCORD_CLIENT_ID="1555247113070317600"
DISCORD_CLIENT_SECRET=""
DISCORD_GUILD_ID="1555246540027596972"
DISCORD_OAUTH_REDIRECT_URI="https://topfragg.gg/api/discord/callback"
# Optional; defaults to JWT_SECRET. Use a separate long random value in production.
DISCORD_OAUTH_STATE_SECRET=""
TOPFRAGG_PUBLIC_URL="https://topfragg.gg"

# Mention chat in general and off-topic; preset replies work without a key.
DISCORD_CHAT_ENABLED="true"
# Optional real AI via Groq. Keep the Groq account on its Free plan.
# Only the tagged message and website guide are sent; no conversation history.
# Missing key, limits or errors automatically use the local preset replies.
GROQ_API_KEY=""
DISCORD_GROQ_ENABLED="true"
DISCORD_GROQ_MODEL="openai/gpt-oss-20b"

# Free 8s voice test only. Linking is required for Free 8s even when moves are off.
# Use the SAME guild and bot above; each lobby gets a private waiting room and team voices.
DISCORD_FREE_8S_VOICE_ENABLED="false"
# Optional public return voice after completion/leave. Empty disconnects players.
# This is never used for lobby readiness or the lobby's join button.
DISCORD_FREE_8S_WAITING_ROOM_ID=""
DISCORD_FREE_8S_VOICE_CATEGORY_ID=""
DISCORD_FREE_8S_VOICE_OVERFLOW_CATEGORY_IDS=""

# Challenge a Team reuses the same Discord bot. If unset, voice enable/category/
# return room inherit Free 8s settings. Channels and ownership stay independent.
# Set a separate category to give Challenge a Team its own Discord area.
# DISCORD_CHALLENGE_VOICE_ENABLED="true"
DISCORD_CHALLENGE_VOICE_CATEGORY_ID=""
DISCORD_CHALLENGE_RETURN_ROOM_ID=""

# Twitch live-stream connection. Create a Twitch Developer application and add
# https://topfragg.gg/api/twitch/callback as its OAuth redirect URL.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
TWITCH_OAUTH_REDIRECT_URI="https://topfragg.gg/api/twitch/callback"
# Optional; defaults to JWT_SECRET. Use a separate long random value in production.
TWITCH_OAUTH_STATE_SECRET=""
